# Server
PORT=4000
NODE_ENV=development

# Database (Postgres recommended)
DATABASE_URL=postgres://user:pass@localhost:5432/sparkshop

# Auth
JWT_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin bootstrap
ADMIN_EMAIL=hydan@codealpha.com
ADMIN_PASSWORD=CodeAlpha@Admin

# File storage (S3 / R2)
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Crypto
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=

# Mobile money
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Bank reconciliation webhook
BANK_WEBHOOK_SECRET=
